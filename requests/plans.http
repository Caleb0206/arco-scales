@cookie = eyJhbGciOiJIUzI1NiJ9.eyJlbWFpbCI6ImNhbGViaHVhbmcwMjA2QGdtYWlsLmNvbSIsIm5hbWUiOiJDYWxlYiBIdWFuZyIsInN1YiI6IjBiY2Y4NzFlLThmNzEtNDBlNC1iOWQxLWNiYmUzZDhmOWIwOSIsImlhdCI6MTc5MzQ5NTk2NCwiZXhwIjoxNzk0MTAwNzY0fQ.2br_og3m-VTNKv0mFBgkHk2TlfOKeWc6DitJqbooFB4
@planId = f99becfa-6bf2-46a9-a6ca-f45d3ae681ac

### Create a plan
POST {{baseUrl}}/api/plans
Content-Type: application/json
Cookie: arco_session={{cookie}}

{
    "name": "Major Foundations 34",
    "description": "Practice common major scales.",
    "scales": ["A Major", "D Major", "G Major"]
}

### List the user's plans
GET {{baseUrl}}/api/plans
Cookie: arco_session={{cookie}}


### Load one plan
GET {{baseUrl}}/api/plans/{{planId}}
Cookie: arco_session={{cookie}}

### Update only the name and scales
PATCH {{baseUrl}}/api/plans/{{planId}}
Content-Type: application/json
Cookie: arco_session={{cookie}}

{
    "name": "Updated Major Foundations 34",
    "scales": [ "D Major", "G Major"]
}

### Restart a plan
PATCH {{baseUrl}}/api/plans/{{planId}}
Content-Type: application/json
Cookie: arco_session={{cookie}}

{
    "action": "restart"
}

### Delete one plan
DELETE {{baseUrl}}/api/plans/{{planId}}
Cookie: arco_session={{cookie}}